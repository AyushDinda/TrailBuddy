# TrailBuddy Backend Configuration
# -------------------------------------------------------------
# Base URL where Ollama is listening locally
OLLAMA_BASE_URL=http://localhost:11434

# Open-weight model installed in Ollama (e.g. qwen3, qwen2.5:7b, llama3.2, mistral)
OLLAMA_MODEL=qwen3

# Allowed frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# SQLite database file path
DATABASE_URL=sqlite:///./trailbuddy.db

# Set to true for deterministic mock generation without running Ollama
MOCK_AI=false

# Ollama API timeout in seconds
OLLAMA_TIMEOUT_SECONDS=60.0
